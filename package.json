{
  "name": "@fakejs/djs-template",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch run  .",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run build && bun run dist/index.js",
    "lint": "biome lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "services:up": "docker-compose -f docker-compose.services.yml up -d",
    "services:down": "docker-compose -f docker-compose.services.yml down"
  },
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "^1.3.13",
    "dotenv": "^17.3.1",
    "prisma": "^7.8.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bullmq": "^6.0.9",
    "discord.js": "^14.21.0",
    "glob": "^11.0.3",
    "ioredis": "^6.0.0"
  }
}
